{
  "name": "slotbay",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/index.js",
    "build": "node scripts/build.js",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:integration": "node --test server/tests/integration.test.js",
    "seed:admin": "node server/seed-admin.js",
    "seed:demo": "node server/seed-demo.js",
    "lint": "eslint .",
    "format": "prettier --write src server",
    "check:email": "node server/check-email.js",
    "build:vercel": "node scripts/build-vercel.js",
    "test:vercel": "node --test server/tests/vercel.test.js server/tests/public-pages.test.js"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.41",
    "@vercel/functions": "^3.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "mongoose": "^8.19.0",
    "nodemailer": "^10.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.3.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/router-plugin": "1.168.42",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "^3.7.3",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.2.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.4"
  },
  "version": "3.2.0",
  "engines": {
    "node": "24.x"
  }
}
