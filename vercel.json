{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/static",
  "env": {
    "NODEJS_HELPERS": "0"
  },
  "functions": {
    "api/handler.js": {
      "maxDuration": 60,
      "includeFiles": "{dist/index.html,src/lib/validation.js}",
      "excludeFiles": "{.env,.env.*,server/tests/**,docs/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/handler"
    },
    {
      "source": "/(.*)",
      "destination": "/api/handler"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/maintenance",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
